{
  "compilerOptions": {
    "checkJs": false,      // 禁用 JS 文件的 TS 检查
    "noEmit": true,        // 不输出编译结果
    "target": "esnext",
    "useDefineForClassFields": true,
    "moduleResolution": "node",
    "strict": true,
    "noLib": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "composite": false,
    "incremental": false,
    "module": "ESNext",
    "types": ["node"],
  },
  "include": ["vite.config.ts"],
  "exclude": ["**/node_modules","node_modules", "dist", "**/*.js", "src/**/*"]
}
